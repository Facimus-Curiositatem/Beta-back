# Copiar a /opt/beta/.env en la VM beta-back y completar. NUNCA subir el .env al repositorio.
#   chmod 600 /opt/beta/.env

# Version de la imagen; el workflow la actualiza en cada despliegue (sha-xxxxxxx)
BACKEND_TAG=latest

DB_HOST=10.43.99.53
DB_PORT=5432
DB_NAME=proyecto_desarrollo
DB_USER=admin
DB_PASSWORD=cambia-esto

# Clave de firma de los JWT. Generar con: openssl rand -hex 32
JWT_SECRET=cambia-esto

# Origen del front (la app usa nginx como proxy, asi que normalmente no hace falta)
CORS_ALLOWED_ORIGINS=https://beta-front.TU-TAILNET.ts.net,http://10.43.99.76:8080

DDL_AUTO=validate
